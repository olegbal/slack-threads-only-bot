# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with connections:write (Basic Information -> App-Level Tokens)
SLACK_APP_TOKEN=xapp-...
# User OAuth Token of the workspace owner/admin who installed the app
SLACK_ADMIN_USER_TOKEN=xoxp-...

# Channels to keep threads-only (comma-separated IDs)
CHANNEL_IDS=C0123ABCD

# Optional: people who may still post top-level (comma-separated user IDs)
ALLOWED_USER_IDS=
# Optional: allow "Also send to channel" replies (default false)
ALLOW_THREAD_BROADCAST=false
# Optional: first line of the ephemeral notice shown when a message is removed
NOTICE_TEXT=
LOG_LEVEL=INFO
